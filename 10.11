using System.ComponentModel;
using System.Text;

string[] lines =
{
    "Иванов Иван;5;4;5;5;4",
    "Петрова Анна;5;5;5;5;5",
    "Сидоров Алексей;3;3;4;3",
    "Кузнецова Мария;4;4;5;4;4",
    "Смирнов Дмитрий;2;3;2;4",
    "Васильева Ольга;5;4;5;4;5",
    "Попов Артём;3;4;3;4;3",
    "Новикова София;4;5;4;5;4"
};
while (true)
{
    Console.WriteLine("1. Добавить");
    Console.WriteLine("2. Редактировать");
    Console.WriteLine("3. Поиск");
    //Console.WriteLine("4. Список");
    Console.WriteLine("5. Выход");

    string choice = Console.ReadLine();

    switch (choice)
    {
        case "1":
            Adds(lines);
            break;
        case "2":
            Redo(lines); 
            break;
        case "3":
            Search(lines);
            break;
        //case "4":
            //ListS(lines); 
            //break;
        case "5":
            return;

    }

}
static void Adds(string[] lines)
{
    Console.WriteLine("ФИО:");
    string fio = Console.ReadLine();
    
    for (int i = 0; i < lines.Length; i++)
    {
        string[] part = lines[i].Split(";");
        if (part[0].Contains(fio))
        {
            Console.WriteLine("Введите количество оценок:");
            int kolvo = int.Parse(Console.ReadLine());
            StringBuilder sb = new StringBuilder(lines[i]);
            for (int j = 1; j <= kolvo; j++)
            {
                Console.WriteLine("Введите оценку:");
                string grade = Console.ReadLine();
                sb.Append(";").Append(grade);
            }
            lines[i] = sb.ToString();
            return;
        }
    }
        
}

static void Redo(string[] lines)
{
    Console.WriteLine("ФИО");
    string fio = Console.ReadLine();
   
    for (int i = 0; i < lines.Length; i++)
    {
        string[] part = lines[i].Split(";");
        if (part[0].Contains(fio))
        {
            Console.WriteLine(lines[i]);
            Console.WriteLine("Какую оценку заменить?");
            int num = int.Parse(Console.ReadLine());
            Console.WriteLine("Новая оценка:");
            part[num] = Console.ReadLine();
            lines[i]= string.Join(";", part);
            return;
        }
    }
}

static void Search(string[] lines)
{
    Console.WriteLine("ФИО");
    string fio = Console.ReadLine();

    for (int i = 0; i < lines.Length; i++)
    {
        string[] part = lines[i].Split(";");
        if (part[0].Contains(fio))
        {
            Console.WriteLine(lines[i]);
            return;
        }
    }
}
